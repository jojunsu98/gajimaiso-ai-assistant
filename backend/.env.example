# Firebase 프로젝트 표시 이름이 아닌 실제 프로젝트 ID를 입력합니다.
FIREBASE_PROJECT_ID=

# 로컬: 사용자가 발급한 키를 프로젝트와 OneDrive 밖에 보관합니다.
# 그 파일의 절대 경로만 지정합니다. 예: C:/Users/사용자명/별도비밀폴더/key.json
# 키 파일 자체를 이 프로젝트로 복사하지 마세요.
GOOGLE_APPLICATION_CREDENTIALS=

# Render에서도 사용할 수 있는 앱 자체 설정입니다.
# 서비스 계정 JSON 문자열을 앱이 직접 파싱하며 SDK 자동 인식에 의존하지 않습니다.
# 비어 있지 않으면 위 파일 경로보다 우선합니다. 잘못된 값이면 우회하지 않고 중단합니다.
# 로컬 파일 경로를 사용할 때는 이 값을 비워 둡니다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 실제 프로세스 환경변수는 이 파일보다 우선합니다(빈 값도 우선).
# 키의 project_id는 FIREBASE_PROJECT_ID와 정확히 같아야 합니다.
# 실제 클라우드 검사는 FIRESTORE_EMULATOR_HOST가 설정돼 있으면 중단합니다.

# 로컬 프론트엔드 CORS 허용 출처(쉼표 구분). CORS는 사용자 인증이 아닙니다.
# 생략 시 아래 두 주소가 기본값입니다. 실제 .env의 기존 값은 보존하세요.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# OpenAI 선택 시 사용합니다. 예제 파일에는 실제 키를 넣지 마세요. 빈 값이면 OpenAI 채팅만 503입니다.
# 기존 환경변수 또는 backend/.env의 키를 재사용하며 새 키를 자동 발급하지 않습니다.
OPENAI_API_KEY=
# 현재 파라미터 호환성을 확인한 모델. 다른 모델은 확인 전 호출을 차단합니다.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_SECONDS=45

# 명시적으로 한 제공자만 사용합니다. 오류가 나도 다른 제공자로 자동 전환하지 않습니다.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TIMEOUT_SECONDS=45
OPENAI_BASE_URL=https://copa.codyssey.kr/v1

# 15단계: 보호 API의 Bearer 토큰. 32자 이상 공백 없는 ASCII 난수를 직접 설정합니다.
# 비어 있거나 형식이 잘못되면 보호 API는 403으로 차단됩니다(로컬에서도 동일).
# OPENAI_API_KEY와 다른 비밀값이며 프론트 코드·URL·로그에 넣지 마세요.
APP_ACCESS_TOKEN=
